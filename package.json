{
  "private": true,
  "scripts": {
    "check": "bash scripts/check.sh && npm run lint:js && npm run lint:css && npm run format:check",
    "lint:js": "eslint \"**/*.js\"",
    "lint:css": "eslint \"css/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10"
  }
}
