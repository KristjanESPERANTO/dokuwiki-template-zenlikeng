{
  "name": "dokuwiki-template-zenlike",
  "version": "7.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bash scripts/check.sh && npm run test && npm run lint && npm run format:check && npm run spellcheck",
    "release": "commit-and-tag-version --commit-all",
    "release:package": "bash scripts/release.sh",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spellcheck": "cspell ."
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "commit-and-tag-version": "^13.3.0",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10"
  },
  "commit-and-tag-version": {
    "releaseCommitMessageFormat": "chore(release): {{currentTag}}",
    "scripts": {
      "prerelease": "bash scripts/pre-release.sh",
      "precommit": "bash scripts/update-release-date.sh"
    }
  }
}
