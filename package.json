{
  "private": true,
  "type": "module",
  "scripts": {
    "check": "bash scripts/check.sh && npm run test && npm run lint && npm run format:check && npm run spellcheck",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spellcheck": "cspell ."
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "cspell": "^10.4.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10"
  }
}
